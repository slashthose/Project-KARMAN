# ==========================================
# PROJECT KARMAN — ENVIRONMENT CONFIGURATION
# ==========================================

# 1. MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/Karman?retryWrites=true&w=majority
DB_NAME=Karman

# 2. Server Base URL (Used for generated PDF links)
# For local development: http://localhost:8000
# For cloud deployment: https://project-karman.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# 3. AI Inference API Keys (Optional — Fallback Heuristic Rule Engine is Active)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# 4. WhatsApp / Telegram Webhook Authentication Token
BOT_WEBHOOK_SECRET=karman_secure_webhook_secret_token_2026
